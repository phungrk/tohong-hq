+#!/usr/bin/env bash
+# Tạo lại styles/tags của vendor pool từ văn bản nguồn; MỌI trường khác của pool giữ nguyên (ADR-025).
+# Chạy từ gốc repo tohong:  bash tools/regen-pool-styles.sh [--back <thư mục tohong-back>]
+# Mặc định --back = edge (submodule). Ghi <back>/lib/vendorPool.generated.js.
+set -euo pipefail
+ROOT="$(cd "$(dirname "$0")/.." && pwd)"
+BACK="$ROOT/edge"
+[ "${1:-}" = "--back" ] && BACK="$(cd "$2" && pwd)"
+POOL="$BACK/lib/vendorPool.generated.js"
+[ -f "$POOL" ] || { echo "✗ không thấy $POOL" >&2; exit 1; }
+cd "$ROOT/tools/scraper"
+python3 clean_style_tags.py                         # 1. tính lại style_tags từ văn bản nguồn
+python3 build_pool.py --out output/pool-vendors.json # 2. gộp theo id
+cd "$ROOT"
+node tools/generate-vendor-pool.js --styles-only --base "$POOL" --out "$POOL"  # 3. chỉ thay styles/tags
