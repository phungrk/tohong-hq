+  }
+  const next = base.map((v) => ({ ...v, styles: tagsById.get(v.id), tags: tagsById.get(v.id) }));
+  writeFileSync(OUT_FILE, src.slice(0, i) + JSON.stringify(next) + src.slice(j));
